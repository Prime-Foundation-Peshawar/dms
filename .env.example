# Copy to .env on the server (never commit real passwords).

CI_ENVIRONMENT = production

# Staging: https://staging.riphahpsh.edu.pk/dms/
# Production: https://dms.riphahpsh.edu.pk/
app.baseURL = 'https://staging.riphahpsh.edu.pk/dms/'
app.forceGlobalSecureRequests = true
app.indexPage = ''

database.default.hostname = localhost
database.default.database = staging_dms
database.default.username = staging_dms
database.default.password = change_me
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

# ACP bootstrap admin (created on first login page load if no users exist)
CMS_ADMIN_EMAIL = admin@riphahpsh.edu.pk
CMS_ADMIN_PASSWORD = change_me

# Legacy aliases (db/apply.php still reads these)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=staging_dms
DB_USERNAME=staging_dms
DB_PASSWORD=change_me
