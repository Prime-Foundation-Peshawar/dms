!/writable/**/.gitkeep
.env
.env.*
!.env.example
.gitignore.ci4
.env.ci4example
error_log
**/error_log
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
/old/
/output/
.php-ini
.php-version
.user.ini
*.bak
* copy.php
/data/faculty-submissions/*
!/data/faculty-submissions/.htaccess
