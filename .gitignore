# Server / runtime logs
error_log
**/error_log
*.log

# CI4 writable (keep folders, ignore contents)
writable/cache/*
!writable/cache/index.html
writable/logs/*
!writable/logs/index.html
writable/session/*
!writable/session/index.html
writable/uploads/*
!writable/uploads/index.html
writable/debugbar/*
!writable/debugbar/index.html

# Archived previous production site (kept on server only)
/old/

# Environment / secrets
.env
.env.*
!.env.example
credentials.json
*.pem

# Do NOT ignore vendor — hosting has no Composer; deploy with vendor committed.
# /vendor/

# OS / editor junk
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# Backups and local copies
*.bak
*.old
*_old.php
* copy.php
*copy.php
*.sql.gz
*.zip
*.tar
*.tar.gz
*.rar

# cPanel / hosting artifacts
.well-known/
cgi-bin/
.php-ini
.php-version
.user.ini
.ftpquota
.softaculous/
.cagefs/

# 4K source + extract frames
/public/assets/videos/pmc-hero-source.mp4
/public/assets/videos/frames/

# Local tooling
.cursor/
.claude/
agent-transcripts/
todo.zip
/dms-ci4-tmp/

# Faculty self-update submissions (pending review)
/data/faculty-submissions/*
!/data/faculty-submissions/.gitkeep
!/data/faculty-submissions/.htaccess
/data/faculty-submissions/photos/
/data/faculty-submissions/docs/
/data/faculty-submissions/.rate/
