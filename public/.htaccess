Options -Indexes

# Staging /dms uses PHP 8.4 for CI4. Production stays on 8.2 unless MultiPHP is changed.
<IfModule mime_module>
  <If "%{HTTP_HOST} =~ /staging\.riphahpsh\.edu\.pk$/i">
    AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
  </If>
  <Else>
    AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
  </Else>
</IfModule>

<IfModule mod_rewrite.c>
	Options +FollowSymlinks
	RewriteEngine On

	# Staging lives at /dms/ — production at site root
	RewriteCond %{HTTP_HOST} ^(www\.)?staging\.riphahpsh\.edu\.pk$ [NC]
	RewriteRule .* - [E=REWRITEBASE:/dms/]
	RewriteCond %{HTTP_HOST} !^(www\.)?staging\.riphahpsh\.edu\.pk$ [NC]
	RewriteRule .* - [E=REWRITEBASE:/]

	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteCond %{REQUEST_URI} (.+)/$
	RewriteRule ^ %1 [L,R=301]

	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^([\s\S]*)$ index.php/$1 [L,NC,QSA]

	RewriteCond %{HTTP:Authorization} .
	RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

<IfModule !mod_rewrite.c>
	ErrorDocument 404 index.php
</IfModule>

ServerSignature Off
