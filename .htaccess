DirectoryIndex index.php index.html

# Staging /dms uses PHP 8.4 for CI4. Production stays on 8.2 unless MultiPHP is changed.
<IfModule mime_module>
  <If "%{HTTP_HOST} =~ /staging\.riphahpsh\.edu\.pk$/i">
    AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
  </If>
  <Else>
    AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
  </Else>
</IfModule>

RewriteEngine On

# Canonical host: www → non-www (production only)
RewriteCond %{HTTP_HOST} ^www\.dms\.riphahpsh\.edu\.pk$ [NC]
RewriteRule ^(.*)$ https://dms.riphahpsh.edu.pk/$1 [R=301,L]

# Prefer clean /dms/ over /dms/index.php
RewriteRule ^index\.php$ public/index.php [L,QSA]
RewriteRule ^index\.php/(.*)$ public/index.php/$1 [L,QSA]

# Send everything through CI4 public/ (shared hosting layout)
RewriteRule ^(.*)$ public/$1 [L]
