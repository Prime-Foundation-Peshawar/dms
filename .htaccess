DirectoryIndex index.php index.html

# Prefer PHP 8.2 for CI4 4.7+ (cPanel EA4). If this host ignores it, set MultiPHP 8.2 for /dms in cPanel.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>

RewriteEngine On

# Canonical host: www → non-www (production only)
RewriteCond %{HTTP_HOST} ^www\.dms\.riphahpsh\.edu\.pk$ [NC]
RewriteRule ^(.*)$ https://dms.riphahpsh.edu.pk/$1 [R=301,L]

# Send everything through CI4 public/ (shared hosting layout)
RewriteRule ^(.*)$ public/$1 [L]
