DirectoryIndex index.php index.html

# Staging /dms uses PHP 8.4 for CI4. Production stays on 8.2 unless MultiPHP is changed.
<IfModule mime_module>
  <If "%{HTTP_HOST} =~ /staging\.riphahpsh\.edu\.pk$/i">
    AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
  </If>
  <Else>
    AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
  </Else>
</IfModule>

RewriteEngine On

# Canonical host: www → non-www (production only)
RewriteCond %{HTTP_HOST} ^www\.dms\.riphahpsh\.edu\.pk$ [NC]
RewriteRule ^(.*)$ https://dms.riphahpsh.edu.pk/$1 [R=301,L]

# Redirect legacy *.php URLs to clean routes (keep query string)
# Staging: /dms/page.php → /dms/page
RewriteCond %{HTTP_HOST} ^(www\.)?staging\.riphahpsh\.edu\.pk$ [NC]
RewriteCond %{THE_REQUEST} \s/dms/index\.php[\s?] [NC]
RewriteRule ^index\.php$ /dms/ [R=301,L,QSA]

RewriteCond %{HTTP_HOST} ^(www\.)?staging\.riphahpsh\.edu\.pk$ [NC]
RewriteCond %{THE_REQUEST} \s/dms/([^\s?]+)\.php[\s?] [NC]
RewriteRule ^(.+)\.php$ /dms/$1 [R=301,L,QSA]

# Production: /page.php → /page
RewriteCond %{HTTP_HOST} !^(www\.)?staging\.riphahpsh\.edu\.pk$ [NC]
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^index\.php$ / [R=301,L,QSA]

RewriteCond %{HTTP_HOST} !^(www\.)?staging\.riphahpsh\.edu\.pk$ [NC]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.php[\s?] [NC]
RewriteRule ^(.+)\.php$ /$1 [R=301,L,QSA]

# Front-controller map into public/
RewriteRule ^(.*)$ public/$1 [L]
